+fn reserve_sm_private_memory<P: Platform>(
+    platform: &P,
+    device: &mut DeviceInfo,
+) {
+    let sbi_region = platform.get_sbi_region();
+
+    // Current crates/sm layout places HEAP_SIZE bytes immediately
+    // after the SBI region, followed by SM_RW_SIZE bytes used by
+    // the PMA metadata allocator.
+    let private_size = P::HEAP_SIZE
+        .checked_add(P::SM_RW_SIZE)
+        .expect("SM private-memory size overflow");
+
+    let region = device
+        .get_mem_region_reserved()
+        .into_iter()
+        .find(|region| {
+            (region.start as usize)
+                .checked_add(region.size)
+                == Some(sbi_region.end)
+        })
+        .expect("reserved-memory region ending at SBI region not found");
+
+    let start = region.start as usize;
+
+    let new_size = region
+        .size
+        .checked_add(private_size)
+        .expect("SM reserved-memory size overflow");
+
+    let old_size = device
+        .update_reserved_mem_region_size(start, new_size)
+        .expect("failed to update SM reserved-memory region");
+
+    log::debug!(
+        "extended reserved-memory at {start:#x}: {old_size:#x} -> {new_size:#x}"
+    );
+    log::debug!(
+        "SM private region reserved for Normal World: {:#x}..{:#x}",
+        sbi_region.end,
+        sbi_region.end + private_size
+    );
+}
